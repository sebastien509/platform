// ============================================================
// stripe-webhook — the sync point for billing state.
//
// Listens for:
//   checkout.session.completed       → set plan_tier
//   customer.subscription.updated    → sync plan_tier
//   customer.subscription.deleted    → downgrade to starter
//   invoice.payment_failed           → billing_status = 'past_due'
//
// Signature is verified against STRIPE_WEBHOOK_SECRET.
// All writes happen as the service role.
// ============================================================

import { serve } from 'https://deno.land/std@0.208.0/http/server.ts';
import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';
import Stripe from 'https://esm.sh/stripe@14.21.0?target=deno';

const STRIPE_SECRET_KEY = Deno.env.get('STRIPE_SECRET_KEY');
const STRIPE_WEBHOOK_SECRET = Deno.env.get('STRIPE_WEBHOOK_SECRET');
const STRIPE_PRICE_PRO = Deno.env.get('STRIPE_PRICE_PRO');
const STRIPE_PRICE_FOUNDER = Deno.env.get('STRIPE_PRICE_FOUNDER');
const STRIPE_PRICE_TEAM = Deno.env.get('STRIPE_PRICE_TEAM');
const SUPABASE_URL = Deno.env.get('SUPABASE_URL')!;
const SUPABASE_SERVICE_KEY = Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!;

const stripe = STRIPE_SECRET_KEY
  ? new Stripe(STRIPE_SECRET_KEY, {
      apiVersion: '2023-10-16',
      httpClient: Stripe.createFetchHttpClient(),
    })
  : null;

function admin() {
  return createClient(SUPABASE_URL, SUPABASE_SERVICE_KEY, {
    auth: { persistSession: false },
  });
}

/** Map a Stripe price ID → our plan tier. */
function tierFromPriceId(
  priceId: string | undefined
): 'pro' | 'founder' | 'team' | null {
  if (!priceId) return null;
  if (priceId === STRIPE_PRICE_PRO) return 'pro';
  if (priceId === STRIPE_PRICE_FOUNDER) return 'founder';
  if (priceId === STRIPE_PRICE_TEAM) return 'team';
  return null;
}

async function updateWorkspace(
  workspaceId: string,
  patch: Record<string, unknown>
) {
  const db = admin();
  const { error } = await db
    .from('workspaces')
    .update(patch)
    .eq('id', workspaceId);
  if (error) {
    console.error('[stripe-webhook] update failed', error.message);
  } else {
    console.log('[stripe-webhook] updated', workspaceId, Object.keys(patch));
  }
}

async function handleEvent(event: Stripe.Event) {
  switch (event.type) {
    case 'checkout.session.completed': {
      const session = event.data.object as Stripe.Checkout.Session;
      const workspaceId = session.client_reference_id;
      if (!workspaceId) return;

      /* Fetch the subscription to learn the price + period. */
      let tier: 'pro' | 'founder' | 'team' | null = null;
      let subscriptionId: string | null = null;
      if (session.subscription) {
        subscriptionId =
          typeof session.subscription === 'string'
            ? session.subscription
            : session.subscription.id;
        if (stripe && subscriptionId) {
          const sub = await stripe.subscriptions.retrieve(subscriptionId);
          tier = tierFromPriceId(sub.items.data[0]?.price?.id);
        }
      }

      await updateWorkspace(
        workspaceId,
        workspaceSync(tier ?? 'pro', subscriptionId, 'active'),
      );
      break;
    }

    case 'customer.subscription.updated': {
      const sub = event.data.object as Stripe.Subscription;
      const workspaceId = (sub.metadata?.workspace_id as string) ?? null;
      if (!workspaceId) return;
      const tier = tierFromPriceId(sub.items.data[0]?.price?.id);
      const status =
        sub.status === 'active' || sub.status === 'trialing'
          ? 'active'
          : sub.status === 'past_due'
          ? 'past_due'
          : sub.status === 'canceled'
          ? 'canceled'
          : 'active';
      const tierKey = tier ?? 'pro';
      await updateWorkspace(
        workspaceId,
        workspaceSync(tierKey, sub.id, status),
      );
      break;
    }

    case 'customer.subscription.deleted': {
      const sub = event.data.object as Stripe.Subscription;
      const workspaceId = (sub.metadata?.workspace_id as string) ?? null;
      if (!workspaceId) return;
      await updateWorkspace(
        workspaceId,
        workspaceSync('starter', null, 'canceled'),
      );
      break;
    }

    case 'invoice.payment_failed': {
      const invoice = event.data.object as Stripe.Invoice;
      const customerId =
        typeof invoice.customer === 'string'
          ? invoice.customer
          : invoice.customer?.id;
      if (!customerId) return;
      const db = admin();
      const { data: ws } = await db
        .from('workspaces')
        .select('id')
        .eq('stripe_customer_id', customerId)
        .maybeSingle();
      if (ws) {
        await updateWorkspace(ws.id, { billing_status: 'past_due' });
      }
      break;
    }

    case 'invoice.payment_succeeded': {
      const invoice = event.data.object as Stripe.Invoice;
      const customerId =
        typeof invoice.customer === 'string'
          ? invoice.customer
          : invoice.customer?.id;
      if (!customerId) return;
      const db = admin();
      const { data: ws } = await db
        .from('workspaces')
        .select('id')
        .eq('stripe_customer_id', customerId)
        .maybeSingle();
      if (ws) {
        await updateWorkspace(ws.id, { billing_status: 'active' });
      }
      break;
    }

    default:
      /* Ignore everything else. */
      break;
  }
}

serve(async (req) => {
  if (req.method !== 'POST') {
    return new Response('Method not allowed', { status: 405 });
  }
  if (!stripe || !STRIPE_WEBHOOK_SECRET) {
    console.error('[stripe-webhook] not configured');
    return new Response('Not configured', { status: 500 });
  }

  const signature = req.headers.get('stripe-signature');
  if (!signature) {
    return new Response('Missing signature', { status: 400 });
  }

  const rawBody = await req.text();

  let event: Stripe.Event;
  try {
    event = await stripe.webhooks.constructEventAsync(
      rawBody,
      signature,
      STRIPE_WEBHOOK_SECRET,
      undefined,
      Stripe.createSubtleCryptoProvider()
    );
  } catch (e) {
    const message = e instanceof Error ? e.message : 'invalid signature';
    console.error('[stripe-webhook] signature verification failed', message);
    return new Response(`Webhook error: ${message}`, { status: 400 });
  }

  try {
    await handleEvent(event);
  } catch (e) {
    const message = e instanceof Error ? e.message : 'handler error';
    console.error('[stripe-webhook] handler failed', message);
    /* Still return 200 so Stripe doesn't retry forever on
       non-recoverable errors. We log everything. */
  }

  return new Response(JSON.stringify({ received: true }), {
    status: 200,
    headers: { 'Content-Type': 'application/json' },
  });
});
