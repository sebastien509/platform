import type { VenturePageKey } from '@/lib/types';
import { EXTRA_OPS } from './extra-ops';

/* ============================================================
   RENDER TYPE — what shape does the output take?
   Every op produces exactly one shape. The router uses this to
   decide which viewer opens on Review / Open.
   ============================================================ */

export type RenderType =
  | 'markdown'     // DocumentViewer — prose, headings, lists
  | 'html'         // SurfaceViewer HTML tab — interactive pages
  | 'deck'         // SurfaceViewer Deck tab — slides
  | 'report'       // DocumentViewer — analytical output
  | 'code'         // CodeView — specs, configs, source
  | 'sheet'        // SheetView — tables, pricing, matrices
  | 'operational'  // No document — collection/status updates
  | 'repo';        // Outbound URL + status card

/* ============================================================
   OP TIER — does this op create a new artifact or refine one?
   Primary = produces a standalone deliverable
   Secondary = refines an existing one (same deliverable, new version)
   ============================================================ */

export type OpTier = 'primary' | 'secondary';

export interface ActionDef {
  id: string;
  verb: string;
  destination: string;
  mode: 'native' | 'connected';
  connector?: string;
  description?: string;
  icon?: string;
  /** Populated on preview. Optional — some actions are pure confirmations. */
  build?: () => ActionPayload;
  /** Marks the action as visually primary in a row. */
  primary?: boolean;
  /** When present, the preview modal renders this surface instead of a payload. */
  surfaceId?: import('@/lib/share').SurfaceId;
  /** Builder for the surface snapshot. Called once at share time. */
  buildSnapshot?: () => import('@/lib/share').ShareSnapshot;
  /**
   * Inputs the agent needs before it can produce an output.
   * Each becomes a block in the drawer's Needs-you zone.
   * When all are answered, the agent proceeds to output.
   */
  requires?: RequireInput[];

  /* ---------- OpsCard display metadata ---------- */

  /** One-line summary of what will be produced. e.g. "PRD", "Deployment". */
  produces?: string;
  /** Cross-page or same-page prerequisites. e.g. ['strategy.icp', 'strategy.positioning']. */
  requiresOps?: string[];
  /** Human labels for requiresOps. Rendered as chips on the card. */
  requiresLabels?: string[];
  /** Optional soft dependency — informational only, doesn\'t block. */
  softDependency?: string;

  /* ---------- Output shape ---------- */

  /** What kind of artifact this op produces. Drives viewer routing. */
  renderType?: RenderType;
  /** Primary produces a new deliverable. Secondary refines an existing one. */
  tier?: OpTier;
  /** For secondary ops — the op id of the deliverable this refines. */
  refinesOpId?: string;

  /* ---------- Agent runtime ---------- */

  /** When true, the drawer keeps the composer visible for the
   *  whole run — chat-style ops (knowledge.ask) rather than
   *  question → wait → continue. */
  conversationMode?: boolean;

  /** The edge function method this op calls. When absent, the
   *  mock builders (def.build / def.buildSnapshot) are used as
   *  fallback. Set during H2/H3 rollout, one domain at a time. */
  agentMethod?: string;

  /** Pin the output kind for this op. When set, the LLM is forced
   *  to return this kind via a narrowed response schema — no
   *  ambiguity. Use for ops whose verb is ambiguous between
   *  "produce a document" and "produce an outbound action".
   *
   *  Examples:
   *    · "Run ICP validation" → email_batch (send survey emails)
   *    · "Share brief"         → snapshot    (produce a document)
   *    · "Log call"            → confirm     (one-shot write)
   */
  expectedOutputKind?: 'snapshot' | 'payload' | 'confirm' | 'email_batch';
}

export interface RequireInput {
  /** Stable id — also used as the block id. */
  id: string;
  kind: 'question' | 'file_request' | 'approval';
  prompt: string;
  /** For 'question' kind. */
  options?: Array<{ label: string; value: string; primary?: boolean }>;
  freeText?: boolean;
  /** For 'file_request' kind. */
  acceptedKinds?: string[];
  destinationHint?: string;
  /** For 'approval' kind. */
  approveLabel?: string;
  rejectLabel?: string;
}

export interface EmailBatchSegment {
  /** Human name for the segment — "SMB solo", "Small firm". */
  name: string;
  /** Estimated recipient count. */
  size?: number;
  /** Optional human filter description — "firm size 1-2 lawyers". */
  filter?: string;
  /** Short hint for what varies per recipient in this segment. */
  personalizationHint?: string;
}

export interface EmailBatch {
  /** Subject line with {{placeholders}}. */
  subjectTemplate: string;
  /** Body with {{placeholders}}. */
  bodyTemplate: string;
  /** Segments the founder can target. */
  segments: EmailBatchSegment[];
  /** Placeholder → source of truth. e.g. { firstName: 'recipient list' }. */
  personalizationRules: Record<string, string>;
  /** Total estimated recipients across all segments. */
  estimatedRecipients?: number;
}

export type ActionPayload =
  | { type: 'confirm'; heading: string; body: string }
  | { type: 'text'; label: string; text: string }
  | { type: 'email'; to: string; subject: string; body: string }
  | { type: 'email_batch'; label: string; batch: EmailBatch }
  | { type: 'html'; label: string; html: string }
  | { type: 'json'; label: string; data: Record<string, unknown> }
  | { type: 'link'; label: string; url: string; description?: string };

